<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View" />

        <variable
            name="viewModel"
            type="com.maimai.android.ui.console.session.MaimaiConsoleViewModel" />

        <variable
            name="state"
            type="com.maimai.android.ui.console.session.ConsoleUiState" />
    </data>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/rootScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/console_title_text"
                android:textSize="26sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/subtitleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/main_subtitle"
                android:textColor="@color/console_subtitle_text"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/titleText" />

            <TextView
                android:id="@+id/qrTitle"
                style="@style/ConsoleSectionTitle"
                android:text="@string/section_qrcode"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/subtitleText" />

            <EditText
                android:id="@+id/qrInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:enabled="@{!state.busy &amp;&amp; !state.loggedIn}"
                android:gravity="top"
                android:hint="@string/hint_qrcode"
                android:inputType="textMultiLine|textNoSuggestions"
                android:maxLines="6"
                android:minLines="4"
                android:onTextChanged="@{(text, start, before, count) -> viewModel.setQrCode(text.toString())}"
                android:padding="12dp"
                android:text="@{state.qrCode}"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/qrTitle" />

            <Button
                android:id="@+id/loginButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:enabled="@{!state.busy &amp;&amp; !state.loggedIn &amp;&amp; state.qrCode.length() > 0}"
                android:onClick="@{() -> viewModel.login()}"
                android:text="@string/action_login"
                app:layout_constraintEnd_toStartOf="@id/logoutButton"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/qrInput" />

            <Button
                android:id="@+id/logoutButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:enabled="@{!state.busy}"
                android:onClick="@{() -> viewModel.logout()}"
                android:text="@string/action_logout"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/loginButton"
                app:layout_constraintTop_toBottomOf="@id/qrInput" />

            <TextView
                android:id="@+id/sessionTitle"
                style="@style/ConsoleSectionTitle"
                android:text="@string/section_session"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/loginButton" />

            <include
                android:id="@+id/statusRow"
                layout="@layout/view_console_value_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:label="@{@string/label_status}"
                app:value="@{state.status}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/sessionTitle" />

            <include
                android:id="@+id/userIdRow"
                layout="@layout/view_console_value_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:label="@{@string/label_user_id}"
                app:value="@{state.userId}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/statusRow" />

            <include
                android:id="@+id/timestampRow"
                layout="@layout/view_console_value_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:label="@{@string/label_timestamp}"
                app:value="@{state.timestamp}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/userIdRow" />

            <include
                android:id="@+id/cookieRow"
                layout="@layout/view_console_value_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:label="@{@string/label_cookie}"
                app:value="@{state.cookieStatus}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/timestampRow" />

            <include
                android:id="@+id/tokenRow"
                layout="@layout/view_console_value_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:label="@{@string/label_token}"
                app:value="@{state.tokenStatus}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cookieRow" />

            <include
                android:id="@+id/upsertRow"
                layout="@layout/view_console_value_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:label="@{@string/label_upsert}"
                app:value="@{state.upsertStatus}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tokenRow" />

            <TextView
                android:id="@+id/errorText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@{state.lastError}"
                android:textColor="@color/console_error_text"
                android:textSize="14sp"
                android:visibility="@{state.lastError == null ? View.GONE : View.VISIBLE}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/upsertRow" />

            <TextView
                android:id="@+id/upsertWaitText"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:text="@{state.upsertWaitText}"
                android:textColor="@color/console_upsert_wait_text"
                android:textSize="14sp"
                android:visibility="@{state.upsertWaiting ? View.VISIBLE : View.INVISIBLE}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/errorText" />

            <ProgressBar
                android:id="@+id/upsertWaitProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="@{state.upsertWaitProgress}"
                android:visibility="@{state.upsertWaiting ? View.VISIBLE : View.INVISIBLE}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/upsertWaitText" />

            <Button
                android:id="@+id/cancelTaskButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:onClick="@{() -> viewModel.cancelCurrentOperation()}"
                android:text="@string/action_cancel_task"
                android:visibility="@{state.upsertWaiting ? View.VISIBLE : View.GONE}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/upsertWaitProgress" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="@{state.busy &amp;&amp; !state.upsertWaiting ? View.VISIBLE : View.GONE}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cancelTaskButton" />

            <TextView
                android:id="@+id/actionTitle"
                style="@style/ConsoleSectionTitle"
                android:text="@string/section_actions"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/progress" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/actionsList"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/actionTitle" />

            <TextView
                android:id="@+id/logTitle"
                style="@style/ConsoleSectionTitle"
                android:layout_width="0dp"
                android:text="@string/section_logs"
                app:layout_constraintEnd_toStartOf="@id/clearLogsButton"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/actionsList" />

            <Button
                android:id="@+id/clearLogsButton"
                android:layout_width="96dp"
                android:layout_height="wrap_content"
                android:onClick="@{() -> viewModel.clearLogs()}"
                android:text="@string/action_clear"
                app:layout_constraintBottom_toBottomOf="@id/logTitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/logTitle" />

            <androidx.core.widget.NestedScrollView
                android:id="@+id/logsScroll"
                android:layout_width="0dp"
                android:layout_height="260dp"
                android:background="@color/console_logs_background"
                android:fillViewport="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/logTitle">

                <TextView
                    android:id="@+id/logsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="@string/logs_empty_initial"
                    android:textColor="@color/console_logs_text"
                    android:textIsSelectable="true"
                    android:textSize="12sp"
                    android:typeface="monospace" />
            </androidx.core.widget.NestedScrollView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</layout>
