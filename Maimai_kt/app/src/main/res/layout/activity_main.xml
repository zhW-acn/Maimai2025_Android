<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View" />

        <variable
            name="viewModel"
            type="com.maimai.android.session.MaimaiConsoleViewModel" />

        <variable
            name="state"
            type="com.maimai.android.session.ConsoleUiState" />
    </data>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/rootScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Maimai Console"
                android:textColor="#102A26"
                android:textSize="26sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/subtitleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Login, run one action, then auto logout."
                android:textColor="#586662"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/titleText" />

            <TextView
                android:id="@+id/qrTitle"
                style="@style/ConsoleSectionTitle"
                android:text="QRCode"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/subtitleText" />

            <EditText
                android:id="@+id/qrInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:enabled="@{!state.busy &amp;&amp; !state.loggedIn}"
                android:gravity="top"
                android:hint="Paste SGWCMAID QRCode text"
                android:inputType="textMultiLine|textNoSuggestions"
                android:maxLines="6"
                android:minLines="4"
                android:onTextChanged="@{(text, start, before, count) -> viewModel.setQrCode(text.toString())}"
                android:padding="12dp"
                android:text="@{state.qrCode}"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/qrTitle" />

            <Button
                android:id="@+id/loginButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:enabled="@{!state.busy &amp;&amp; !state.loggedIn &amp;&amp; state.qrCode.length() > 0}"
                android:onClick="@{() -> viewModel.login()}"
                android:text="Login"
                app:layout_constraintEnd_toStartOf="@id/logoutButton"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/qrInput" />

            <Button
                android:id="@+id/logoutButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:enabled="@{!state.busy &amp;&amp; state.loggedIn}"
                android:onClick="@{() -> viewModel.logout()}"
                android:text="Logout"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/loginButton"
                app:layout_constraintTop_toBottomOf="@id/qrInput" />

            <TextView
                android:id="@+id/sessionTitle"
                style="@style/ConsoleSectionTitle"
                android:text="Session"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/loginButton" />

            <include
                android:id="@+id/statusRow"
                layout="@layout/view_console_value_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:label='@{"Status"}'
                app:value="@{state.status}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/sessionTitle" />

            <include
                android:id="@+id/userIdRow"
                layout="@layout/view_console_value_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:label='@{"User ID"}'
                app:value="@{state.userId}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/statusRow" />

            <include
                android:id="@+id/timestampRow"
                layout="@layout/view_console_value_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:label='@{"Timestamp"}'
                app:value="@{state.timestamp}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/userIdRow" />

            <include
                android:id="@+id/cookieRow"
                layout="@layout/view_console_value_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:label='@{"Cookie"}'
                app:value="@{state.cookieStatus}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/timestampRow" />

            <include
                android:id="@+id/tokenRow"
                layout="@layout/view_console_value_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:label='@{"Token"}'
                app:value="@{state.tokenStatus}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cookieRow" />

            <TextView
                android:id="@+id/errorText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@{state.lastError}"
                android:textColor="#B3261E"
                android:textSize="14sp"
                android:visibility="@{state.lastError == null ? View.GONE : View.VISIBLE}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tokenRow" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="@{state.busy ? View.VISIBLE : View.GONE}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/errorText" />

            <TextView
                android:id="@+id/actionTitle"
                style="@style/ConsoleSectionTitle"
                android:text="Actions"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/progress" />

            <Button
                android:id="@+id/uploadButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:enabled="@{!state.busy &amp;&amp; state.loggedIn}"
                android:onClick="@{() -> viewModel.uploadDemoScore()}"
                android:text="Upload demo score"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/actionTitle" />

            <Button
                android:id="@+id/unlockButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:enabled="@{!state.busy &amp;&amp; state.loggedIn}"
                android:onClick="@{() -> viewModel.unlockDemoMaster()}"
                android:text="Unlock demo Master"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/uploadButton" />

            <Button
                android:id="@+id/versionButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:enabled="@{!state.busy &amp;&amp; state.loggedIn}"
                android:onClick="@{() -> viewModel.changeVersion()}"
                android:text="Change version"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/unlockButton" />

            <TextView
                android:id="@+id/logTitle"
                style="@style/ConsoleSectionTitle"
                android:layout_width="0dp"
                android:text="Logs"
                app:layout_constraintEnd_toStartOf="@id/clearLogsButton"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/versionButton" />

            <Button
                android:id="@+id/clearLogsButton"
                android:layout_width="96dp"
                android:layout_height="wrap_content"
                android:onClick="@{() -> viewModel.clearLogs()}"
                android:text="Clear"
                app:layout_constraintBottom_toBottomOf="@id/logTitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/logTitle" />

            <androidx.core.widget.NestedScrollView
                android:id="@+id/logsScroll"
                android:layout_width="0dp"
                android:layout_height="260dp"
                android:background="#F3F6F4"
                android:fillViewport="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/logTitle">

                <TextView
                    android:id="@+id/logsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="No logs"
                    android:textColor="#23312E"
                    android:textIsSelectable="true"
                    android:textSize="12sp"
                    android:typeface="monospace" />
            </androidx.core.widget.NestedScrollView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</layout>
